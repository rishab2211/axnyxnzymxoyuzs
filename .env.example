# WindScope Environment Configuration Example
# Copy to .env for local overrides

# Database Configuration
POSTGRES_USER=windscope
POSTGRES_PASSWORD=windscope
POSTGRES_DB=windscope_db
DATABASE_URL=postgresql+psycopg://windscope:windscope@localhost:5432/windscope_db

# Elexon API Configuration
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_RATE_LIMIT_PER_MINUTE=5000
ELEXON_REQUEST_TIMEOUT_SECONDS=30.0

# Decision Cutoff Assumption (UTC)
DEFAULT_DECISION_CUTOFF=11:00

# Evaluation Window
EVALUATION_START_DATE=2026-01-01
EVALUATION_END_DATE=2026-01-31

# Automatic Ingestion Trigger on Startup (if database is empty)
AUTO_INGEST_ON_STARTUP=true

# Application Environment
ENVIRONMENT=development
